# ==============================================================================
# LLM-Detection-Main — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT REAL .env FILES, CERTIFICATES, OR API KEYS TO VERSION CONTROL.
# Real .env files are automatically ignored by .gitignore.
# ==============================================================================

# Backend Gateway Server Binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
# CORS Allowed Origins: * for all (default), or comma-separated list e.g. https://my-static-site.onrender.com
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# AWS EC2 Inference Gateway Configuration
# ------------------------------------------------------------------------------
# EC2 Gateway Base URL (HTTPS behind Nginx reverse proxy)
NLI_SERVICE_BASE_URL=https://13.205.17.228
NLI_VERIFY_PATH=/nli/verify
NLI_VERIFY_BATCH_PATH=/nli/verify-batch
NLI_HEALTH_PATH=/nli/health

LLM_SERVICE_BASE_URL=https://13.205.17.228
LLM_CORRECT_PATH=/llm/correct
LLM_HEALTH_PATH=/llm/health

# Gateway Authentication Header (X-API-Key)
# In Render: configure this as a private environment variable under Dashboard > Environment.
# NEVER hardcode or commit your actual API key.
INFERENCE_API_KEY=your_ec2_inference_api_key_here

# ------------------------------------------------------------------------------
# TLS Certificate Verification & Custom CA Bundle
# ------------------------------------------------------------------------------
# Production requirement: TLS verification is strictly enabled (verify=True or CA bundle).
# If the EC2 gateway uses a self-signed TLS certificate or custom private CA:
# Provide the absolute path to the trusted CA certificate (PEM format).
# On Render: Use "Secret Files" to mount the CA certificate (e.g. /etc/secrets/ec2_ca.crt)
# and set: INFERENCE_CA_BUNDLE_PATH=/etc/secrets/ec2_ca.crt
# Leave empty to use the system default CA store (for valid public certificates).
INFERENCE_CA_BUNDLE_PATH=

# ------------------------------------------------------------------------------
# Network Timeouts & Resiliency (in seconds)
# ------------------------------------------------------------------------------
INFERENCE_CONNECT_TIMEOUT=5
INFERENCE_READ_TIMEOUT=30
INFERENCE_MAX_RETRIES=1
